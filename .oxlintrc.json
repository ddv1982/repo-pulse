{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "error" },
  "plugins": ["typescript"],
  "categories": { "correctness": "warn" },
  "jsPlugins": [{ "name": "eslint-js", "specifier": "oxlint-plugin-eslint" }],
  "env": { "builtin": true, "es2024": true },
  "ignorePatterns": [
    "dist/**",
    "web/vendor/**",
    ".repo-pulse/**",
    "test-results/**",
    "playwright-report/**",
    "playwright/.cache/**",
    "coverage/**"
  ],
  "rules": {
    "no-unreachable": "error",
    "no-dupe-keys": "error",
    "no-unused-vars": ["error", { "args": "none", "caughtErrors": "none" }],
    // Every function was brought to 30 or below in November 2026; split a function rather than raising this.
    "complexity": ["error", 30],
    // node:test's test() promise resolves when the test ends, also on failure; the runner reports results, so registrations need no await. A subtest the parent depends on still needs one; this exemption covers t.test() too.
    "typescript/no-floating-promises": [
      "error",
      { "allowForKnownSafeCalls": [{ "from": "package", "package": "node:test", "name": "test" }] }
    ],
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    // ESLint's no-undef (Oxlint's ignores "off" globals) for JavaScript only; tsc reports undefined names in TypeScript.
    { "files": ["**/*.{js,cjs}"], "rules": { "eslint-js/no-undef": "error" } },
    {
      "files": ["**/*.{js,ts}"],
      "env": { "node": true },
      // Node's env includes the CommonJS globals, which are undefined in ES modules.
      "globals": { "require": "off", "module": "off", "exports": "off", "__dirname": "off", "__filename": "off" }
    },
    { "files": ["**/*.cjs"], "env": { "node": true, "commonjs": true } },
    { "files": ["src/**/*.{js,ts}", "web/**/*.{js,ts}", "e2e/**/*.{js,ts}"], "env": { "browser": true } },
    // UI tests read rendered markup through test/fixtures/dom.ts, so a markup change only breaks a test when what a person
    // sees changes. A regular expression over the HTML would pin its exact shape again. See docs/MAINTAINING.md.
    {
      "files": ["test/merge-ui.test.ts", "test/sync-status-ui.test.ts", "test/presentation.test.ts"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "Literal[regex.pattern=/class=[\"']|\\b(?:href|title|role|id|aria-[a-z-]+|data-[a-z-]+)=[\"']|<\\\\?\\/?(?:a|b|p|dd|dt|dl|h[1-6]|ul|ol|li|div|span|strong|time|code|svg|path|circle|line|section|article|details|summary|button|label|input)\\b/]",
            "message": "Check rendered UI with test/fixtures/dom.ts (text, one, row) instead of a regular expression over its HTML."
          }
        ]
      }
    }
  ]
}

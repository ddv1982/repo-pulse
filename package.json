{
  "name": "repo-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build:web": "node scripts/build-web.ts",
    "watch:web": "node scripts/build-web.ts --watch",
    "prestart": "npm run build:web",
    "start": "node server.ts",
    "predemo": "npm run build:web",
    "demo": "node server.ts --demo",
    "doctor": "node scripts/doctor.ts",
    "pretest": "npm run build:web",
    "test": "node --test \"test/*.test.ts\"",
    "pretest:fast": "npm run build:web",
    "test:fast": "node --test --test-skip-pattern=\"starts racing|same database refuses|lock held by a run|closing releases the lock|v11 database|blocked by an open reader|every older database version\" \"test/!(checkout-advice|checkout-branches|checkout-git).test.ts\"",
    "pretest:dom": "npm run build:web",
    "test:dom": "node --test --test-timeout=60000 e2e/dom.test.ts",
    "pretest:ui": "npm run build:web",
    "test:ui": "node --test --test-timeout=60000 \"e2e/*.test.ts\"",
    "check:types": "tsc",
    "lint": "oxlint --deny-warnings . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.6",
    "oxlint": "1.95.0",
    "oxlint-plugin-eslint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}

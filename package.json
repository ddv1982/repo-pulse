{
  "name": "repo-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --demo",
    "doctor": "node scripts/doctor.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:ui": "node --test e2e/*.test.js",
    "check:types": "tsc -p tsconfig.web.json && tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.6",
    "linkedom": "0.18.15",
    "oxlint": "1.95.0",
    "oxlint-plugin-eslint": "1.95.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}

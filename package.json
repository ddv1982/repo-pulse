{
  "name": "repo-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build:web": "node -e \"process.getBuiltinModule('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.web.json",
    "watch:web": "tsc -p tsconfig.web.json --watch",
    "prestart": "npm run build:web",
    "start": "node server.ts",
    "predemo": "npm run build:web",
    "demo": "node server.ts --demo",
    "doctor": "node scripts/doctor.ts",
    "pretest": "npm run build:web",
    "test": "node --test \"test/*.test.ts\"",
    "check": "node scripts/check.ts",
    "pretest:ui": "npm run build:web",
    "test:ui": "node --test \"e2e/*.test.ts\"",
    "check:types": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.hook.json",
    "lint": "oxlint --deny-warnings . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.6",
    "linkedom": "0.18.15",
    "oxlint": "1.95.0",
    "oxlint-plugin-eslint": "1.95.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}

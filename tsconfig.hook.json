{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The Git hook stays CommonJS JavaScript (Node cannot strip types in an extensionless hook), so only this program reads JavaScript.
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["server/checkout-delete-guard.cjs"]
}
